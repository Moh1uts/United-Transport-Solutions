<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title><%= client.name %> — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <img src="/images/logo-white-nav.png" alt="United Transport Solutions">
    </div>
    <a href="/potential">Demandes Potentielles</a>
    <a href="/waiting">Demandes en Attente</a>
    <a href="/active">Demandes Actives</a>
    <a href="/refused">Demandes Refusées</a>
    <a href="/finished">Demandes Terminées</a>
    <a href="/invoices">Factures</a>
    <details class="nav-dropdown">
      <summary>Rapports</summary>
      <div class="nav-dropdown-menu">
        <a href="/report">Rapport Mensuel</a>
        <a href="/rapport-factures">Rapport Factures</a>
        <a href="/rapport-cash">Rapport Cash</a>
        <a href="/rapport-recouvrement">Recouvrement</a>
      </div>
    </details>
    <a href="/clients/new">+ Ajouter une demande</a>
    <a href="/settings" style="opacity:0.6;">Réglages</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <% if (flash) { %><div class="flash"><%= flash %></div><% } %>

  <%
    const statusLabels = { potential: 'Potentielle', waiting: 'En Attente', active: 'Active', refused: 'Refusée', finished: 'Terminée' };
  %>
  <h1><%= client.name %> <span class="badge <%= client.status %>"><%= statusLabels[client.status] || client.status %></span></h1>

  <div class="card">
    <div class="field-grid">
      <div><label>Téléphone</label><%= client.phone %></div>
      <div><label>Email</label><%= client.email %></div>
      <div><label>Trajet</label><%= client.city %> → <%= client.destination %></div>
      <div><label>Nature de la marchandise</label><%= client.nature %></div>
      <div><label>Colis</label><%= client.packages ?? '—' %></div>
      <div><label>Poids brut</label><%= client.weightKg ? client.weightKg + ' kg' : '—' %></div>
      <div class="<%= dimGroups.length > 1 ? 'full' : '' %>">
        <label>Dimensions (L x l x H, cm)</label>
        <% if (dimGroups.length === 0) { %>
          —
        <% } else if (dimGroups.length === 1) { %>
          <%= dimGroups[0].longueur %> x <%= dimGroups[0].largeur %> x <%= dimGroups[0].hauteur %><%= dimGroups[0].count > 1 ? ` x${dimGroups[0].count}` : '' %>
        <% } else { %>
          <ul style="margin:4px 0 0; padding-left:18px;">
            <% dimGroups.forEach(g => { %>
              <li><%= g.longueur %> x <%= g.largeur %> x <%= g.hauteur %> cm<% if (g.count > 1) { %> <strong>x<%= g.count %></strong><% } %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div><label>Volume</label><%= client.volume ? client.volume + ' m³' : '—' %></div>
      <div><label>Gerbable</label><%= client.gerbable || '—' %></div>
      <div><label>ICE</label><%= client.ice || '—' %></div>
      <div><label>Date souhaitée</label><%= client.preferredDate || '—' %></div>
      <div><label>Source</label><%= client.source %></div>
      <div class="full"><label>Notes</label><%= client.notes || '—' %></div>
      <% if (client.refusalReason) { %>
        <div class="full"><label>Raison du refus</label><%= client.refusalReason %></div>
      <% } %>
      <% if (client.outcome) { %>
        <div class="full">
          <label>Résultat</label>
          <% if (client.outcome === 'success') { %><span class="badge success">Succès</span><% } %>
          <% if (client.outcome === 'failed') { %><span class="badge failed">Problème : <%= client.outcomeReason %></span><% } %>
        </div>
      <% } %>
    </div>
  </div>

  <% if (client.status === 'potential') { %>
    <h2>Actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>Prêt à travailler avec vous</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Indique au client que nous pouvons prendre l'envoi, avec un ou plusieurs devis (tarif au kg, TTC).</p>
        <% if (lastEvents.ready_to_work) { %>
          <div class="sent-note">Envoyé le <%= new Date(lastEvents.ready_to_work).toLocaleString('fr-FR') %></div>
        <% } %>

        <form method="POST" action="/clients/<%= client.id %>/ready-to-work" id="readyToWorkForm">
          <div class="rtw-mode" style="display:flex; gap:14px; margin-bottom:10px; font-size:13px;">
            <label style="display:flex; align-items:center; gap:5px; font-weight:normal;">
              <input type="radio" name="rtwMode" value="single" checked> Devis unique
            </label>
            <label style="display:flex; align-items:center; gap:5px; font-weight:normal;">
              <input type="radio" name="rtwMode" value="multiple"> Devis multiples
            </label>
          </div>

          <div id="rtwQuoteBlocks"></div>

          <button type="button" id="rtwAddQuote" class="btn small ghost" style="display:none; margin-bottom:8px;">+ Ajouter un devis</button>

          <button class="btn <%= lastEvents.ready_to_work ? '' : 'green' %> small" type="submit"><%= lastEvents.ready_to_work ? 'Renvoyer' : 'Envoyer' %></button>
        </form>

        <datalist id="rtwAirports">
          <option value="Paris - Charles de Gaulle (CDG)">
          <option value="Paris - Orly (ORY)">
          <option value="Lyon - Saint-Exupéry (LYS)">
          <option value="Marseille Provence (MRS)">
          <option value="Bruxelles (BRU)">
          <option value="Amsterdam - Schiphol (AMS)">
          <option value="Francfort (FRA)">
          <option value="Madrid - Barajas (MAD)">
          <option value="Barcelone - El Prat (BCN)">
          <option value="Milan - Malpensa (MXP)">
          <option value="Rome - Fiumicino (FCO)">
          <option value="Londres - Heathrow (LHR)">
          <option value="Genève (GVA)">
          <option value="Budapest - Ferenc Liszt (BUD)">
          <option value="Montréal - Trudeau (YUL)">
          <option value="Toronto - Pearson (YYZ)">
          <option value="New York - JFK (JFK)">
          <option value="Dubaï (DXB)">
          <option value="Istanbul (IST)">
          <option value="Doha - Hamad (DOH)">
        </datalist>
        <datalist id="rtwAirlines">
          <option value="Air France">
          <option value="Royal Air Maroc">
          <option value="Air Arabia Maroc">
          <option value="Air Arabia">
          <option value="Ryanair">
          <option value="Transavia">
          <option value="Turkish Airlines">
          <option value="Emirates">
          <option value="Qatar Airways">
          <option value="Lufthansa">
          <option value="Air Canada">
        </datalist>

        <script>
          (function() {
            var wrap = document.getElementById('readyToWorkForm');
            var blocksEl = document.getElementById('rtwQuoteBlocks');
            var addBtn = document.getElementById('rtwAddQuote');
            var modeRadios = wrap.querySelectorAll('input[name="rtwMode"]');
            var blockCount = 0;

            function makeBlock() {
              var i = blockCount++;
              var box = document.createElement('div');
              box.className = 'rtw-quote-block';
              box.style.cssText = 'border:1px solid var(--line); padding:8px; margin-bottom:8px; display:grid; grid-template-columns:1fr; gap:6px; position:relative;';
              box.innerHTML =
                '<input type="text" list="rtwAirports" name="quotes[' + i + '][airport]" placeholder="Aéroport (destination)" required>' +
                '<input type="text" list="rtwAirlines" name="quotes[' + i + '][company]" placeholder="Compagnie (ex: Air France)" required>' +
                '<select name="quotes[' + i + '][direct]" required>' +
                  '<option value="">Vol direct ou non direct ?</option>' +
                  '<option value="Direct">Vol direct</option>' +
                  '<option value="Non direct">Vol non direct (escale)</option>' +
                '</select>' +
                '<input type="number" step="0.01" name="quotes[' + i + '][tarif]" placeholder="Tarif DHS/kg (TTC)" required>' +
                '<button type="button" class="rtw-remove btn small ghost" style="width:fit-content;">Retirer ce devis</button>';
              box.querySelector('.rtw-remove').addEventListener('click', function() {
                box.remove();
                renumber();
                syncRemoveButtons();
              });
              return box;
            }

            // Bracket indices just need to be present and parseable server-side;
            // qs (Express's urlencoded parser) sorts numeric keys, so exact
            // renumbering after a removal isn't required for the array itself
            // to come through correctly - we do it anyway for cleanliness.
            function renumber() {
              var boxes = blocksEl.querySelectorAll('.rtw-quote-block');
              boxes.forEach(function(box, idx) {
                box.querySelectorAll('[name]').forEach(function(el) {
                  el.name = el.name.replace(/quotes\[\d+\]/, 'quotes[' + idx + ']');
                });
              });
              blockCount = boxes.length;
            }

            function syncRemoveButtons() {
              var boxes = blocksEl.querySelectorAll('.rtw-quote-block');
              boxes.forEach(function(box, idx) {
                var btn = box.querySelector('.rtw-remove');
                // Always allow removing down to zero blocks in "multiple" mode;
                // in "single" mode there's only ever one block and no button shown.
                btn.style.display = (currentMode() === 'multiple' && boxes.length > 1) ? '' : 'none';
              });
            }

            function currentMode() {
              var checked = wrap.querySelector('input[name="rtwMode"]:checked');
              return checked ? checked.value : 'single';
            }

            function applyMode() {
              var boxes = blocksEl.querySelectorAll('.rtw-quote-block');
              if (currentMode() === 'single') {
                // Collapse down to exactly one block.
                for (var k = boxes.length - 1; k > 0; k--) boxes[k].remove();
                addBtn.style.display = 'none';
              } else {
                addBtn.style.display = '';
              }
              renumber();
              syncRemoveButtons();
            }

            modeRadios.forEach(function(r) { r.addEventListener('change', applyMode); });
            addBtn.addEventListener('click', function() {
              blocksEl.appendChild(makeBlock());
              renumber();
              syncRemoveButtons();
            });

            // Start with a single quote block, matching the default "single" mode.
            blocksEl.appendChild(makeBlock());
            applyMode();
          })();
        </script>
      </div>

      <div class="action-box">
        <h3>❌ Désolé, nous ne pouvons pas</h3>
        <form method="POST" action="/clients/<%= client.id %>/refuse">
          <textarea name="reason" placeholder="Raison (obligatoire)" required></textarea>
          <button class="btn red small" type="submit">Envoyer et déplacer vers Refusés</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (client.status === 'waiting') { %>
    <h2>Actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>Réponse du client</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Enregistrée automatiquement quand le client clique Accepter/Refuser dans l'email "Nous sommes prêts".</p>
        <% if (!client.clientResponse) { %>
          <div class="sent-note" style="color:var(--navy-soft);">⏳ Pas encore de réponse</div>
        <% } else if (client.clientResponse === 'accepted') { %>
          <div class="sent-note" style="color:var(--green, #2e7d32);">✅ Le client a accepté<% if (client.clientResponseAt) { %> — <%= new Date(client.clientResponseAt).toLocaleString('fr-FR') %><% } %></div>
        <% } else { %>
          <div class="sent-note" style="color:var(--red, #c62828);">✖️ Le client a refusé<% if (client.clientResponseAt) { %> — <%= new Date(client.clientResponseAt).toLocaleString('fr-FR') %><% } %></div>
        <% } %>
      </div>

      <div class="action-box">
        <h3>🔔 Relance (pas de réponse)</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Rappel amical que nous sommes toujours disponibles.</p>
        <% if (lastEvents.rewake) { %>
          <div class="sent-note">Envoyé le <%= new Date(lastEvents.rewake).toLocaleString('fr-FR') %></div>
          <form method="POST" action="/clients/<%= client.id %>/rewake">
            <button class="btn small ghost" type="submit">Renvoyer</button>
          </form>
        <% } else { %>
          <form method="POST" action="/clients/<%= client.id %>/rewake">
            <button class="btn ghost small" type="submit">Envoyer le rappel</button>
          </form>
        <% } %>
      </div>

      <div class="action-box">
        <h3>➡️ Déplacer vers Demandes Actives</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Une fois que le client a confirmé son acceptation.</p>
        <form method="POST" action="/clients/<%= client.id %>/activate">
          <button class="btn small" type="submit">Déplacer vers Actifs</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (client.status === 'active') { %>
    <h2>Actions sur l'envoi</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>1. Envoi reçu (téléphone/message)</h3>
        <% if (lastEvents.order_received) { %>
          <div class="sent-note">Envoyé le <%= new Date(lastEvents.order_received).toLocaleString('fr-FR') %></div>
          <form method="POST" action="/clients/<%= client.id %>/order-received">
            <button class="btn small ghost" type="submit">Renvoyer</button>
          </form>
        <% } else { %>
          <form method="POST" action="/clients/<%= client.id %>/order-received">
            <button class="btn small" type="submit">Enregistrer et notifier le client</button>
          </form>
        <% } %>
      </div>

      <div class="action-box">
        <h3>2. Envoi expédié</h3>
        <% if (lastEvents.order_shipped) { %><div class="sent-note">Envoyé le <%= new Date(lastEvents.order_shipped).toLocaleString('fr-FR') %></div><% } %>
        <form method="POST" action="/clients/<%= client.id %>/order-shipped">
          <input name="flightNumber" placeholder="Numéro de vol (ex : AF 1597)" value="<%= client.flightNumber || '' %>" required>
          <input name="lta" placeholder="Numéro LTA" value="<%= client.lta || '' %>" required>
          <button class="btn small <%= lastEvents.order_shipped ? 'ghost' : '' %>" type="submit"><%= lastEvents.order_shipped ? 'Renvoyer' : 'Envoyer' %></button>
        </form>
      </div>

      <div class="action-box">
        <h3>3. Envoi arrivé (génère la facture)</h3>
        <% if (invoices.length > 0) { %>
          <div class="sent-note">Facture <%= invoices[0].invoiceNumber %> (<%= invoices[0].lang.toUpperCase() %>) générée le <%= new Date(invoices[0].createdAt).toLocaleString('fr-FR') %></div>
          <a href="/invoices/<%= invoices[0].id %>/download" class="btn small ghost" style="margin-right:8px; display:inline-block;">Télécharger</a>
          <a href="/invoices/<%= invoices[0].id %>/edit" class="btn small ghost" style="margin-right:8px; display:inline-block;">Modifier</a>
          <form method="POST" action="/clients/<%= client.id %>/resend-invoice" style="display:inline;">
            <button class="btn small ghost" type="submit">Renvoyer la facture</button>
          </form>
        <% } else { %>
          <form method="POST" action="/clients/<%= client.id %>/order-arrived" id="orderArrivedForm">
            <input name="flightNumber" placeholder="Numéro de vol (ex : AF 1597)" value="<%= client.flightNumber || '' %>">
            <input name="lta" placeholder="Numéro LTA" value="<%= client.lta || '' %>">
            <input name="designation" placeholder="Désignation (défaut : Fret aérien)">
            <label style="font-family:monospace; font-size:11.5px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">ICE (pré-rempli depuis la fiche client, modifiable)</label>
            <input name="ice" placeholder="ICE" value="<%= client.ice || '' %>">
            <label style="font-family:monospace; font-size:11.5px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">N° DE FACTURE (laisser vide pour générer automatiquement)</label>
            <input name="invoiceNumber" placeholder="ex : 00073/26">
            <label style="font-family:monospace; font-size:11.5px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">FOURNISSEUR (compagnie aérienne)</label>
            <input id="fournisseurInput" placeholder="ex : NEGOFRET">
            <label style="font-family:monospace; font-size:11.5px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">POIDS VOLUMÉTRIQUE (kg)</label>
            <input type="number" step="0.01" id="poidsVolInput" placeholder="0">

            <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer; margin-top:10px;">
              <input type="checkbox" id="chkFlatRate" style="width:16px; height:16px;"> Montant fixe négocié (au lieu d'un tarif au kg)
            </label>

            <div id="perKgFields" style="display:flex; gap:8px; align-items:flex-end; margin-top:6px;">
              <div style="flex:1;">
                <label style="font-family:monospace; font-size:11px; color:var(--navy-soft); display:block; margin-bottom:4px;">TARIF AF (DHS/kg)</label>
                <input type="number" step="0.01" id="tarifAFInput" placeholder="0">
              </div>
              <div style="flex:1;">
                <label style="font-family:monospace; font-size:11px; color:var(--navy-soft); display:block; margin-bottom:4px;">TARIF UTS (DHS/kg)</label>
                <input type="number" step="0.01" id="tarifUTSInput" placeholder="0">
              </div>
            </div>
            <div id="flatFields" style="display:none; gap:8px; align-items:flex-end; margin-top:6px;">
              <div style="flex:1;">
                <label style="font-family:monospace; font-size:11px; color:var(--navy-soft); display:block; margin-bottom:4px;">FACT COMP (coût, MAD)</label>
                <input type="number" step="0.01" id="factCompFlatInput" placeholder="0">
              </div>
              <div style="flex:1;">
                <label style="font-family:monospace; font-size:11px; color:var(--navy-soft); display:block; margin-bottom:4px;">FACTURATION UTS (MAD)</label>
                <input type="number" step="0.01" id="facturationUTSFlatInput" placeholder="0">
              </div>
            </div>

            <label style="font-family:monospace; font-size:11px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">AUTRE FRAIS (MAD, optionnel)</label>
            <input type="number" step="0.01" id="autreFraisInput" placeholder="0">

            <div style="background:var(--bg-soft, #f4f6f9); border:1px solid var(--line); border-radius:6px; padding:10px; margin-top:10px; font-size:13px; line-height:1.8;">
              <div>Poids facturable : <strong id="calcPoidsTaxable">0</strong> kg</div>
              <div>Fact Comp (coût) : <strong id="calcFactComp">0.00</strong> MAD</div>
              <div>Facturation UTS (= montant facture) : <strong id="calcFacturationUTS">0.00</strong> MAD</div>
              <div>Nette UTS (profit) : <strong id="calcNetteUTS">0.00</strong> MAD</div>
            </div>

            <div style="display:flex; gap:16px; margin-top:10px; margin-bottom:4px;">
              <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer;">
                <input type="checkbox" id="chkTaxable" style="width:16px; height:16px;"> Taxable
              </label>
              <label style="display:flex; align-items:center; gap:6px; font-size:13.5px; cursor:pointer;">
                <input type="checkbox" id="chkNonTaxable" checked style="width:16px; height:16px;"> Non Taxable
              </label>
            </div>
            <input type="hidden" name="qte" id="qteHidden" value="1">
            <input type="hidden" name="montant" id="montantHidden">
            <input type="hidden" name="taxType" id="taxTypeHidden">
            <input type="hidden" name="fournisseur" id="fournisseurHidden">
            <input type="hidden" name="poidsVol" id="poidsVolHidden">
            <input type="hidden" name="flatRate" id="flatRateHidden">
            <input type="hidden" name="tarifAF" id="tarifAFHidden">
            <input type="hidden" name="tarifUTS" id="tarifUTSHidden">
            <input type="hidden" name="factComp" id="factCompHidden">
            <input type="hidden" name="facturationUTS" id="facturationUTSHidden">
            <input type="hidden" name="autreFrais" id="autreFraisHidden">
            <input type="hidden" name="netteUTS" id="netteUTSHidden">
            <label style="font-family:monospace; font-size:11.5px; color:var(--navy-soft); display:block; margin-top:8px; margin-bottom:4px;">LANGUE DE LA FACTURE</label>
            <select name="lang" style="width:100%; padding:9px; border:1px solid var(--line); font-size:14px; margin-bottom:8px;">
              <option value="fr" selected>Français</option>
              <option value="en">English</option>
            </select>
            <button class="btn green small" type="submit">Générer la facture et envoyer</button>
          </form>
          <script>
            (function() {
              var chkTaxable = document.getElementById('chkTaxable');
              var chkNonTaxable = document.getElementById('chkNonTaxable');
              chkTaxable.addEventListener('change', function() {
                if (this.checked) chkNonTaxable.checked = false;
              });
              chkNonTaxable.addEventListener('change', function() {
                if (this.checked) chkTaxable.checked = false;
              });

              var chkFlatRate = document.getElementById('chkFlatRate');
              var perKgFields = document.getElementById('perKgFields');
              var flatFields = document.getElementById('flatFields');
              var clientWeightKg = <%= client.weightKg || 0 %>;

              function num(id) {
                var v = parseFloat(document.getElementById(id).value);
                return isNaN(v) ? 0 : v;
              }

              function recalc() {
                var isFlat = chkFlatRate.checked;
                perKgFields.style.display = isFlat ? 'none' : 'flex';
                flatFields.style.display = isFlat ? 'flex' : 'none';

                var poidsVol = num('poidsVolInput');
                var poidsTaxable = Math.max(clientWeightKg, poidsVol);
                var autreFrais = num('autreFraisInput');
                var factComp, facturationUTS;

                if (isFlat) {
                  factComp = num('factCompFlatInput');
                  facturationUTS = num('facturationUTSFlatInput');
                } else {
                  var tarifAF = num('tarifAFInput');
                  var tarifUTS = num('tarifUTSInput');
                  factComp = Math.round(tarifAF * poidsTaxable * 100) / 100;
                  facturationUTS = Math.round(tarifUTS * poidsTaxable * 100) / 100;
                }
                var netteUTS = Math.round((facturationUTS - factComp - autreFrais) * 100) / 100;

                document.getElementById('calcPoidsTaxable').textContent = poidsTaxable.toFixed(2);
                document.getElementById('calcFactComp').textContent = factComp.toFixed(2);
                document.getElementById('calcFacturationUTS').textContent = facturationUTS.toFixed(2);
                document.getElementById('calcNetteUTS').textContent = netteUTS.toFixed(2);

                document.getElementById('montantInput_cache_factComp').value = factComp;
                document.getElementById('montantInput_cache_facturationUTS').value = facturationUTS;
                document.getElementById('montantInput_cache_netteUTS').value = netteUTS;
                document.getElementById('montantInput_cache_poidsVol').value = poidsVol;
              }

              // Cache inputs (not submitted directly, just used to stash live-calculated values)
              ['factComp', 'facturationUTS', 'netteUTS', 'poidsVol'].forEach(function(key) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.id = 'montantInput_cache_' + key;
                document.getElementById('orderArrivedForm').appendChild(hidden);
              });

              ['poidsVolInput', 'tarifAFInput', 'tarifUTSInput', 'factCompFlatInput', 'facturationUTSFlatInput', 'autreFraisInput'].forEach(function(id) {
                document.getElementById(id).addEventListener('input', recalc);
              });
              chkFlatRate.addEventListener('change', recalc);
              recalc();

              document.getElementById('orderArrivedForm').addEventListener('submit', function() {
                recalc();
                document.getElementById('qteHidden').value = '1';
                document.getElementById('montantHidden').value = document.getElementById('montantInput_cache_facturationUTS').value || '0';
                document.getElementById('taxTypeHidden').value = chkTaxable.checked ? 'taxable' : 'nonTaxable';
                document.getElementById('fournisseurHidden').value = document.getElementById('fournisseurInput').value || '';
                document.getElementById('poidsVolHidden').value = document.getElementById('montantInput_cache_poidsVol').value || '0';
                document.getElementById('flatRateHidden').value = chkFlatRate.checked ? '1' : '';
                document.getElementById('tarifAFHidden').value = document.getElementById('tarifAFInput').value || '';
                document.getElementById('tarifUTSHidden').value = document.getElementById('tarifUTSInput').value || '';
                document.getElementById('factCompHidden').value = document.getElementById('montantInput_cache_factComp').value || '0';
                document.getElementById('facturationUTSHidden').value = document.getElementById('montantInput_cache_facturationUTS').value || '0';
                document.getElementById('autreFraisHidden').value = document.getElementById('autreFraisInput').value || '0';
                document.getElementById('netteUTSHidden').value = document.getElementById('montantInput_cache_netteUTS').value || '0';
              });
            })();
          </script>
        <% } %>
      </div>

      <div class="action-box">
        <h3>Créance sans facture</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Pour un envoi qui doit déjà de l'argent avant qu'une vraie facture existe. Apparaît comme "S/F" dans les listes ; utilisez "Modifier" plus tard pour la transformer en vraie facture.</p>
        <form method="POST" action="/clients/<%= client.id %>/add-debt">
          <input name="lta" placeholder="Numéro LTA" value="<%= client.lta || '' %>">
          <input type="number" step="0.01" name="montant" placeholder="Montant dû (MAD)" required>
          <input name="note" placeholder="Note (ex : en attente de facture)">
          <button class="btn small ghost" type="submit" style="margin-top:6px;">Enregistrer la créance</button>
        </form>
      </div>

      <div class="action-box">
        <h3>4. Envoi en retard</h3>
        <% if (lastEvents.order_late) { %><div class="sent-note">Envoyé le <%= new Date(lastEvents.order_late).toLocaleString('fr-FR') %></div><% } %>
        <form method="POST" action="/clients/<%= client.id %>/order-late">
          <textarea name="reason" placeholder="Raison (obligatoire)" required></textarea>
          <button class="btn small <%= lastEvents.order_late ? 'ghost' : '' %>" type="submit"><%= lastEvents.order_late ? 'Renvoyer' : 'Envoyer' %></button>
        </form>
      </div>

      <div class="action-box">
        <h3>5. Problème avec l'envoi</h3>
        <% if (lastEvents.order_problem) { %><div class="sent-note">Envoyé le <%= new Date(lastEvents.order_problem).toLocaleString('fr-FR') %></div><% } %>
        <form method="POST" action="/clients/<%= client.id %>/order-problem">
          <textarea name="reason" placeholder="Raison (obligatoire)" required></textarea>
          <button class="btn small <%= lastEvents.order_problem ? 'ghost' : '' %>" type="submit"><%= lastEvents.order_problem ? 'Renvoyer' : 'Envoyer' %></button>
        </form>
      </div>

      <div class="action-box">
        <h3>6. Envoi annulé</h3>
        <% if (lastEvents.order_cancelled) { %><div class="sent-note">Envoyé le <%= new Date(lastEvents.order_cancelled).toLocaleString('fr-FR') %></div><% } %>
        <form method="POST" action="/clients/<%= client.id %>/order-cancelled">
          <textarea name="reason" placeholder="Raison (obligatoire)" required></textarea>
          <button class="btn <%= lastEvents.order_cancelled ? 'ghost' : 'red' %> small" type="submit"><%= lastEvents.order_cancelled ? 'Renvoyer' : 'Envoyer' %></button>
        </form>
      </div>

      <div class="action-box">
        <h3>Terminer — Succès</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Remercie le client, tout s'est bien passé.</p>
        <form method="POST" action="/clients/<%= client.id %>/finish-success">
          <button class="btn green small" type="submit">Envoyer et déplacer vers Terminés</button>
        </form>
      </div>

      <div class="action-box">
        <h3>😔 Terminer — Problème</h3>
        <form method="POST" action="/clients/<%= client.id %>/finish-failed">
          <textarea name="reason" placeholder="Raison (obligatoire)" required></textarea>
          <button class="btn red small" type="submit">Envoyer et déplacer vers Terminés</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (client.status === 'refused') { %>
    <h2>Actions</h2>
    <div class="action-grid">
      <div class="action-box">
        <h3>1. Inviter à nouveau — circonstances changées</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Nous pouvons maintenant traiter le même envoi.</p>
        <% if (lastEvents.invite_back_same) { %>
          <div class="sent-note">Envoyé le <%= new Date(lastEvents.invite_back_same).toLocaleString('fr-FR') %></div>
          <form method="POST" action="/clients/<%= client.id %>/invite-back-same">
            <button class="btn small ghost" type="submit">Renvoyer</button>
          </form>
        <% } else { %>
          <form method="POST" action="/clients/<%= client.id %>/invite-back-same">
            <button class="btn green small" type="submit">Envoyer</button>
          </form>
        <% } %>
      </div>

      <div class="action-box">
        <h3>2. Inviter à nouveau — service différent</h3>
        <% if (lastEvents.invite_back_other) { %><div class="sent-note">Envoyé le <%= new Date(lastEvents.invite_back_other).toLocaleString('fr-FR') %></div><% } %>
        <form method="POST" action="/clients/<%= client.id %>/invite-back-other">
          <input name="serviceOffer" placeholder="Décrire l'autre service" required>
          <button class="btn small <%= lastEvents.invite_back_other ? 'ghost' : '' %>" type="submit"><%= lastEvents.invite_back_other ? 'Renvoyer' : 'Envoyer' %></button>
        </form>
      </div>

      <div class="action-box">
        <h3>3. ↩️ Remettre en Demandes Actives</h3>
        <p style="font-size:12.5px; color:var(--navy-soft);">Le client a accepté de revenir — aucun message n'est envoyé, juste un changement de catégorie.</p>
        <form method="POST" action="/clients/<%= client.id %>/activate">
          <button class="btn small" type="submit">Remettre en Actifs</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (invoices.length > 0) { %>
    <h2>Factures pour ce client</h2>
    <table>
      <thead><tr><th>N° Facture</th><th>Date</th><th>Montant TTC</th><th></th></tr></thead>
      <tbody>
        <% invoices.forEach(inv => { %>
          <tr>
            <td><%= inv.invoiceNumber %></td>
            <td><%= new Date(inv.createdAt).toLocaleDateString('fr-FR') %></td>
            <td><%= inv.amountTTC.toFixed(2) %> MAD</td>
            <td><a href="/invoices/<%= inv.id %>/download">Télécharger</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2>Historique</h2>
  <div class="card">
    <% if (events.length === 0) { %>
      <p>Aucun événement pour le moment.</p>
    <% } %>
    <% events.forEach(e => { %>
      <div class="history-item">
        <span class="date"><%= new Date(e.createdAt).toLocaleString('fr-FR') %></span>
        <span class="type"><%= e.type %></span>
        <% if (e.reason) { %> — <%= e.reason %><% } %>
        <% if (e.trackingNumber) { %> — <%= e.trackingNumber %><% } %>
        <% if (e.serviceOffer) { %> — <%= e.serviceOffer %><% } %>
        <% if (e.messageSent === false) { %> <span style="color:var(--red);">(message échoué — vérifier la configuration SMS/email)</span><% } %>
      </div>
    <% }) %>
  </div>
</main>
</body>
</html>
