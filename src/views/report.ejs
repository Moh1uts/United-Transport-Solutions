<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Rapport Mensuel — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <img src="/images/logo-white-nav.png" alt="United Transport Solutions">
    </div>
    <a href="/potential">Clients Potentiels</a>
    <a href="/active">Clients Actifs</a>
    <a href="/refused">Clients Refusés</a>
    <a href="/finished">Clients Terminés</a>
    <a href="/invoices">Factures</a>
    <details class="nav-dropdown">
      <summary>Rapports</summary>
      <div class="nav-dropdown-menu">
        <a href="/report">Rapport Mensuel</a>
        <a href="/rapport-factures">Rapport Factures</a>
        <a href="/rapport-cash">Rapport Cash</a>
        <a href="/rapport-recouvrement">Recouvrement</a>
      </div>
    </details>
    <a href="/clients/new">+ Ajouter un client</a>
    <a href="/settings" style="opacity:0.6;">Réglages</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <h1>Rapport Mensuel — <%= label %></h1>

  <form method="GET" action="/report" style="margin-bottom:20px;">
    <input type="month" name="month" value="<%= monthParam %>" onchange="this.form.submit()">
  </form>

  <div class="stat-row">
    <div class="stat"><div class="num"><%= invoices.length %></div><div class="label">ENVOIS LIVRÉS</div></div>
    <div class="stat"><div class="num"><%= totalRevenue.toFixed(0) %> MAD</div><div class="label">CHIFFRE D'AFFAIRES (TTC)</div></div>
    <div class="stat"><div class="num"><%= counts.shipped %></div><div class="label">EXPÉDIÉES</div></div>
    <div class="stat"><div class="num"><%= counts.late %></div><div class="label">EN RETARD</div></div>
    <div class="stat"><div class="num"><%= counts.problem %></div><div class="label">PROBLÈMES</div></div>
    <div class="stat"><div class="num"><%= counts.cancelled %></div><div class="label">ANNULÉES</div></div>
  </div>

  <a class="btn" href="/report/download?month=<%= monthParam %>">Télécharger le rapport PDF</a>

  <h2>Factures ce mois-ci</h2>
  <% if (invoices.length === 0) { %>
    <div class="card">Aucune facture ce mois-ci.</div>
  <% } else { %>
    <table>
      <thead><tr><th>N° Facture</th><th>Client</th><th>Date</th><th>Montant TTC</th></tr></thead>
      <tbody>
        <% invoices.forEach(inv => { %>
          <tr>
            <td><%= inv.invoiceNumber %></td>
            <td><%= inv.clientName %></td>
            <td><%= new Date(inv.createdAt).toLocaleDateString('fr-FR') %></td>
            <td><%= inv.amountTTC.toFixed(2) %> MAD</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2 style="margin-top:40px;">Suivi des expéditions par camion</h2>
  <p style="color:var(--navy-soft); margin-top:-10px; margin-bottom:20px;">
    Suivi des envois transportés par camion vers CDG avant un vol de connexion.
  </p>
  <a class="btn" href="/report/truck/new" style="margin-bottom:24px; display:inline-block;">+ Ajouter une expédition camion</a>

  <h3>En transit</h3>
  <% if (enTransit.length === 0) { %>
    <div class="card">Aucune expédition en transit.</div>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>LTA N°</th><th>Date Réception</th><th>Colis</th><th>Poids</th><th>Destination</th>
          <th>ETD Truck</th><th>ETA Truck CDG</th><th>Date Vol Connexion</th><th>Commentaires</th><th>Remarque</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% enTransit.forEach(t => { %>
          <tr>
            <td><%= t.ltaNumber %></td>
            <td><%= t.dateReception ? new Date(t.dateReception).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.colis ?? '—' %></td>
            <td><%= t.poids ?? '—' %></td>
            <td><%= t.destination || '—' %></td>
            <td><%= t.etdTruck ? new Date(t.etdTruck).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.etaTruckCdg ? new Date(t.etaTruckCdg).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.dateFlightConex ? new Date(t.dateFlightConex).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.comments || '—' %></td>
            <td><%= t.remarque || '—' %></td>
            <td>
              <form method="POST" action="/report/truck/<%= t.id %>/arrivee">
                <button class="btn small green" type="submit">Marquer arrivée</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>

  <h3 style="margin-top:32px;">Arrivées ce mois-ci</h3>
  <% if (arrivees.length === 0) { %>
    <div class="card">Aucune arrivée ce mois-ci.</div>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>LTA N°</th><th>Date Réception</th><th>Colis</th><th>Poids</th><th>Destination</th>
          <th>ETD Truck</th><th>ETA Truck CDG</th><th>Date Vol Connexion</th><th>Commentaires</th>
        </tr>
      </thead>
      <tbody>
        <% arrivees.forEach(t => { %>
          <tr>
            <td><%= t.ltaNumber %></td>
            <td><%= t.dateReception ? new Date(t.dateReception).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.colis ?? '—' %></td>
            <td><%= t.poids ?? '—' %></td>
            <td><%= t.destination || '—' %></td>
            <td><%= t.etdTruck ? new Date(t.etdTruck).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.etaTruckCdg ? new Date(t.etaTruckCdg).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.dateFlightConex ? new Date(t.dateFlightConex).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= t.comments || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</main>
</body>
</html>
