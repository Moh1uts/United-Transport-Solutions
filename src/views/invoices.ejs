<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Factures — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <img src="/images/logo-white-nav.png" alt="United Transport Solutions">
    </div>
    <a href="/potential">Clients Potentiels</a>
    <a href="/active">Clients Actifs</a>
    <a href="/refused">Clients Refusés</a>
    <a href="/finished">Clients Terminés</a>
    <a href="/invoices">Factures</a>
    <a href="/report">Rapport Mensuel</a>
    <a href="/clients/new">+ Ajouter un client</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <h1>Factures</h1>
  <p style="color:var(--navy-soft); margin-top:-10px;">
    Chaque facture jamais générée (via « Envoi arrivé ») est stockée ici de façon permanente — c'est votre dossier de données.
  </p>

  <% if (invoices.length === 0) { %>
    <div class="card">Aucune facture générée pour le moment.</div>
  <% } else { %>
    <table>
      <thead>
        <tr><th>N° Facture</th><th>Client</th><th>Date</th><th>Montant TTC</th><th></th><th></th></tr>
      </thead>
      <tbody>
        <% invoices.forEach(inv => { %>
          <tr>
            <td><%= inv.invoiceNumber %></td>
            <td><a class="row-link" href="/clients/<%= inv.clientId %>"><%= inv.client.name %></a></td>
            <td><%= new Date(inv.createdAt).toLocaleDateString('fr-FR') %></td>
            <td><%= inv.amountTTC.toFixed(2) %> MAD</td>
            <td><a href="/invoices/<%= inv.id %>/download">Télécharger</a></td>
            <td><a href="/invoices/<%= inv.id %>/edit">Modifier</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
</body>
</html>
