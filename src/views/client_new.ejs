<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Ajouter une demande — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <img src="/images/logo-white-nav.png" alt="United Transport Solutions">
    </div>
    <a href="/potential">Demandes Potentielles</a>
    <a href="/waiting">Demandes en Attente</a>
    <a href="/active">Demandes Actives</a>
    <a href="/refused">Demandes Refusées</a>
    <a href="/finished">Demandes Terminées</a>
    <a href="/invoices">Factures</a>
    <details class="nav-dropdown">
      <summary>Rapports</summary>
      <div class="nav-dropdown-menu">
        <a href="/report">Rapport Mensuel</a>
        <a href="/rapport-factures">Rapport Factures</a>
        <a href="/rapport-cash">Rapport Cash</a>
        <a href="/rapport-recouvrement">Recouvrement</a>
      </div>
    </details>
    <a href="/clients/new">+ Ajouter une demande</a>
    <a href="/settings" style="opacity:0.6;">Réglages</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <h1>Ajouter une demande (réception par téléphone / email)</h1>
  <p style="color:var(--navy-soft); margin-top:-10px;">
    Utilisez ce formulaire lorsqu'un client vous appelle ou vous écrit directement, sans passer par le site web.
    Elle sera ajoutée aux <strong>Demandes Potentielles</strong> et recevra automatiquement la confirmation
    « devis reçu » par SMS et email.
  </p>

  <% if (error) { %><p class="error"><%= error %></p><% } %>

  <form method="POST" action="/clients" class="card">
    <div class="field-grid">
      <div><label>Nom / Société *</label><input name="name" required></div>
      <div><label>Téléphone *</label><input name="phone" required placeholder="+212 6XX XXX XXX"></div>
      <div><label>Email *</label><input type="email" name="email" required></div>
      <div>
        <label>Ville de départ *</label>
        <select name="city" required>
          <option value="Casablanca">Casablanca</option>
          <option value="Marrakech">Marrakech</option>
          <option value="Fès">Fès</option>
          <option value="Tanger">Tanger</option>
          <option value="Rabat">Rabat</option>
          <option value="Autre">Autre</option>
        </select>
      </div>
      <div><label>Destination *</label><input name="destination" required></div>
      <div><label>Date d'expédition souhaitée</label><input type="date" name="preferredDate"></div>
      <div class="full"><label>Nature de la marchandise *</label><input name="nature" required></div>
      <div><label>Nombre de colis</label><input type="number" name="packages" min="1"></div>
      <div><label>Poids brut (kg)</label><input type="number" name="weightKg" min="0"></div>
      <div><label>Longueur (cm)</label><input type="number" step="0.1" min="0" name="longueur" id="dimLongueur"></div>
      <div><label>Largeur (cm)</label><input type="number" step="0.1" min="0" name="largeur" id="dimLargeur"></div>
      <div><label>Hauteur (cm)</label><input type="number" step="0.1" min="0" name="hauteur" id="dimHauteur"></div>
      <div><label>Volume (m³)</label><input name="volume" id="dimVolume" readonly style="background:#f2f2f2;"></div>
      <div>
        <label>Marchandise gerbable ?</label>
        <select name="gerbable">
          <option value="">-- Sélectionner --</option>
          <option value="Oui">Oui</option>
          <option value="Non">Non</option>
        </select>
      </div>
      <div><label>ICE (si société)</label><input name="ice"></div>
      <div class="full"><label>Notes</label><textarea name="notes"></textarea></div>
    </div>
    <button class="btn" type="submit" style="margin-top:16px;">Ajouter la demande et envoyer la confirmation</button>
  </form>
</main>
<script>
  function recomputeDimVolume(){
    const num = id => parseFloat(document.getElementById(id).value) || 0;
    const l = num('dimLongueur'), w = num('dimLargeur'), h = num('dimHauteur');
    const volumeEl = document.getElementById('dimVolume');
    volumeEl.value = (l > 0 && w > 0 && h > 0) ? ((l * w * h) / 1000000).toFixed(3) : '';
  }
  ['dimLongueur','dimLargeur','dimHauteur'].forEach(id => {
    document.getElementById(id).addEventListener('input', recomputeDimVolume);
  });
</script>
</body>
</html>
