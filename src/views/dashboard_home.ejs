<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Dashboard — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <a href="/dashboard"><img src="/images/logo-white-nav.png" alt="United Transport Solutions"></a>
    </div>
    <a href="/dashboard" class="active">Dashboard</a>
    <a href="/potential">Demandes Potentielles</a>
    <a href="/waiting">Demandes en Attente</a>
    <a href="/active">Demandes Actives</a>
    <a href="/refused">Demandes Refusées</a>
    <a href="/finished">Demandes Terminées</a>
    <a href="/invoices">Factures</a>
    <details class="nav-dropdown">
      <summary>Rapports</summary>
      <div class="nav-dropdown-menu">
        <a href="/report">Rapport Mensuel</a>
        <a href="/rapport-factures">Rapport Factures</a>
        <a href="/rapport-cash">Rapport Cash</a>
        <a href="/rapport-recouvrement">Recouvrement</a>
      </div>
    </details>
    <a href="/clients/new">+ Ajouter une demande</a>
    <a href="/settings" style="opacity:0.6;">Réglages</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <h1>Dashboard</h1>

  <div class="stat-row">
    <a class="stat stat-link" href="/potential">
      <div class="num"><%= counts.potential %></div>
      <div class="label">DEMANDES POTENTIELLES</div>
    </a>
    <a class="stat stat-link" href="/waiting">
      <div class="num"><%= counts.waiting %></div>
      <div class="label">DEMANDES EN ATTENTE</div>
    </a>
    <a class="stat stat-link" href="/active">
      <div class="num"><%= counts.active %></div>
      <div class="label">DEMANDES ACTIVES</div>
    </a>
    <a class="stat stat-link" href="/refused">
      <div class="num"><%= counts.refused %></div>
      <div class="label">DEMANDES REFUSÉES</div>
    </a>
    <a class="stat stat-link" href="/finished">
      <div class="num"><%= counts.finished %></div>
      <div class="label">DEMANDES TERMINÉES</div>
    </a>
  </div>

  <div class="card">
    <p style="font-size:13.5px; color:var(--navy-soft); margin:0;">
      Cliquez sur une catégorie pour voir la liste correspondante. Total :
      <strong><%= counts.potential + counts.waiting + counts.active + counts.refused + counts.finished %></strong>
      demande(s).
    </p>
  </div>
</main>
</body>
</html>
