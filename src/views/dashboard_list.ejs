<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title><%= title %> — United Transport Solutions</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <div class="wrap">
    <div class="topnav-brand">
        <img src="/images/logo-white-nav.png" alt="United Transport Solutions">
    </div>
    <a href="/potential">Clients Potentiels</a>
    <a href="/active">Clients Actifs</a>
    <a href="/refused">Clients Refusés</a>
    <a href="/finished">Clients Terminés</a>
    <a href="/invoices">Factures</a>
    <a href="/report">Rapport Mensuel</a>
    <a href="/clients/new">+ Ajouter un client</a>
    <a href="/monthly-archives" style="position:relative; text-decoration:none; margin-right:10px; font-size:18px;" title="Archives mensuelles">🔔<% if (typeof unreadArchive !== 'undefined' && unreadArchive) { %><span style="position:absolute; top:-2px; right:-2px; width:8px; height:8px; background:#e53935; border-radius:50%; display:inline-block; border:1.5px solid #fff;"></span><% } %></a>
    <form method="POST" action="/logout"><button class="logout">Déconnexion</button></form>
  </div>
</nav>
<main class="wrap">
  <h1><%= title %> <span class="badge <%= category %>"><%= clients.length %></span></h1>

  <% if (clients.length === 0) { %>
    <div class="card">Aucun client dans cette catégorie pour le moment.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Nom</th>
          <th>Téléphone</th>
          <th>Email</th>
          <th>Trajet</th>
          <th>Nature</th>
          <th>Source</th>
          <% if (category === 'finished') { %><th>Résultat</th><th>Facture(s) / Payé</th><% } %>
          <th>Reçu le</th>
        </tr>
      </thead>
      <tbody>
        <% clients.forEach(c => { %>
          <tr>
            <td><a class="row-link" href="/clients/<%= c.id %>"><%= c.name %></a></td>
            <td><%= c.phone %></td>
            <td><%= c.email %></td>
            <td><%= c.city %> → <%= c.destination %></td>
            <td><%= c.nature %></td>
            <td><%= c.source %></td>
            <% if (category === 'finished') { %>
              <td>
                <% if (c.outcome === 'success') { %><span class="badge success">Succès</span><% } %>
                <% if (c.outcome === 'failed') { %><span class="badge failed">Problème</span><% } %>
              </td>
              <td>
                <% if (!c.invoices || c.invoices.length === 0) { %>
                  <span style="color:var(--navy-soft); font-size:12.5px;">—</span>
                <% } else { %>
                  <div style="display:flex; flex-direction:column; gap:6px;">
                    <% c.invoices.forEach(inv => { %>
                      <form method="POST" action="/invoices/<%= inv.id %>/toggle-paid?back=finished" style="display:flex; align-items:center; gap:6px; font-size:12.5px;">
                        <span style="font-family:monospace;"><%= inv.invoiceNumber %></span>
                        <span><%= inv.amountTTC.toFixed(2) %> MAD</span>
                        <label style="display:flex; align-items:center; gap:4px; cursor:pointer;">
                          <input type="checkbox" name="paid" onchange="this.form.submit()" <%= inv.paid ? 'checked' : '' %> style="width:14px; height:14px;">
                          Payé
                        </label>
                      </form>
                    <% }) %>
                  </div>
                <% } %>
              </td>
            <% } %>
            <td><%= new Date(c.createdAt).toLocaleDateString('fr-FR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
</body>
</html>
