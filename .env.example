# Copy this file to .env for local testing, and set the same values as
# "Environment Variables" in Render's dashboard for production.
# NEVER commit a real .env file to GitHub.

# --- Database -----------------------------------------------------------
# On Render: create a free PostgreSQL database, then copy its
# "Internal Database URL" here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Session --------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- First admin login (used once by `npm run seed`) -----------------------
ADMIN_EMAIL="dad@unitedtransportsolutions.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Company info (used inside message templates & invoices) ---------------
COMPANY_NAME="United Transport Solutions"
COMPANY_PHONE="+212 700-172779"
COMPANY_EMAIL="contact@unitedtransportsolutions.com"

# --- Email sending (Google Workspace SMTP) ----------------------------------
# SMTP_USER is the mailbox itself. SMTP_APP_PASSWORD is a 16-character App
# Password generated from Google Account settings - NOT the normal login
# password. See README "Setting up Google Workspace email sending".
SMTP_USER="contact@unitedtransportsolutions.com"
SMTP_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# --- SMS sending (Twilio) ----------------------------------------------------
# From https://console.twilio.com after creating an account and buying a
# phone number with international SMS enabled.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# --- Public quote API (called by the marketing website's form) -------------
# Any random string - must match exactly what's set in the website's
# index.html (see README "Connecting the website to this backend").
PUBLIC_QUOTE_API_KEY="replace-with-another-random-string"

# The website's exact URL, so the backend allows it to call the public API.
# No trailing slash.
ALLOWED_ORIGIN="https://unitedtransportsolutions.com"

NODE_ENV="production"
